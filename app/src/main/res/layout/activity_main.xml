<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stealth Copilot Setup"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Upload your resume or add custom project context so the AI tailors interview answers to your exact background."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Resume Upload Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Resume / Experience Document (.txt, .pdf)"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#334155"
                android:text="Select File"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvResumeStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="No file selected"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Custom Details Text Area -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Custom Background / Priority Points"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomContext"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:gravity="top|start"
            android:hint="Add specific details (e.g., .NET Core, Microservices, Vue.js, recent company projects, key strengths to highlight)..."
            android:padding="12dp"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <!-- Launch Overlay Action Button -->
        <Button
            android:id="@+id/btnLaunchOverlay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#0284C7"
            android:text="Launch Floating Overlay"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Check for Update Action Button -->
        <Button
            android:id="@+id/btnUpdateApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:text="🔄 Check for App Update"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>